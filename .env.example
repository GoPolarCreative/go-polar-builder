# Go Polar Website Builder - environment reference
#
# LOCAL:      copy this to `.env.local` (gitignored). Nothing in it is required: with an empty
#             file the app runs in demo mode against an embedded database and local file storage.
# PRODUCTION: Vercel project environment variables.
#
# NOTHING HERE REACHES THE BROWSER. Vite only exposes vars prefixed VITE_, and there are
# deliberately none. `npm run build` fails if a secret-shaped string appears in dist/.
#
# Everything is read at runtime. Nothing is hardcoded and nothing is stubbed: with a variable
# missing, the feature that needs it fails with an error naming that exact variable.

# ===========================================================================
# MODES AND SAFETY RAILS
# ===========================================================================

# Demo mode. Every outbound integration is replaced by a local fake that logs what it would have
# done. No payment, no email, no CRM, no DNS. Defaults ON when nothing else is configured, so a
# fresh clone is safe by default.
DEMO_MODE=1

# Live action switches. ALL OFF BY DEFAULT, and ignored entirely while DEMO_MODE is on.
# Each one gates something irreversible, and a blocked action throws with the flag name rather
# than silently doing nothing.
ENABLE_LIVE_PAYMENTS=0
ENABLE_LIVE_EMAIL=0
ENABLE_LIVE_CRM=0
ENABLE_LIVE_DOMAINS=0

# ===========================================================================
# REQUIRED FOR THE APP TO FUNCTION
# ===========================================================================

# Signs build tokens, session cookies and discharge download links.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_SECRET=

# The real public URL. Used to build emailed links, so it has to be right.
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Production: provision Postgres from the Vercel marketplace (Neon by default) and paste the
# connection string. Local: leave both blank and the embedded PGlite database is used, which
# needs no server and no account.
DATABASE_URL=
# postgres | pglite. Inferred from DATABASE_URL when not set.
DATABASE_DRIVER=
PGLITE_DIR=.local/pglite

# ---------------------------------------------------------------------------
# Storage (Vercel Blob)
# ---------------------------------------------------------------------------
# Create a Blob store in the Vercel dashboard. Local: leave blank to store files under
# .local/blob instead.
BLOB_READ_WRITE_TOKEN=
# vercel-blob | local. Inferred from the token when not set.
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=.local/blob

# ---------------------------------------------------------------------------
# Anthropic (generation)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Runs generation against a deterministic offline fixture instead of the Anthropic API, so the
# pipeline and every verification check can be exercised without a key.
# NEVER SET THIS IN PRODUCTION.
DEV_OFFLINE_GENERATION=1

# ---------------------------------------------------------------------------
# Render checks 13 to 16
# ---------------------------------------------------------------------------
# playwright | hosted | none
#   playwright - bundled Chromium on Vercel, an installed Chrome or Edge locally
#   hosted     - a remote headless browser over CDP, set BROWSERLESS_URL
#   none       - checks 13 to 16 report skipped, never pass
RENDER_DRIVER=playwright
BROWSERLESS_URL=
# Point at a specific browser binary if the automatic search does not find one.
CHROME_PATH=

# ---------------------------------------------------------------------------
# Go Polar infrastructure injected server side (never asked of the customer)
# ---------------------------------------------------------------------------
# Go Polar's own key, stamped into every generated site. Must be a UUID.
#
# PREVIEW AND EDITING ONLY. The customer supplies their own key in the go-live flow, it is tested
# with a real submission before it is accepted, and a site cannot be published while this key is
# still in the document. See DECISIONS.md D29.
WEB3FORMS_ACCESS_KEY=00000000-0000-0000-0000-000000000000

# Test-only override for the Web3Forms endpoint, so the verification tests can point at a local
# stub instead of the real service. Leave unset everywhere else.
WEB3FORMS_API_URL=

# ===========================================================================
# SHOPIFY - all payments, one-off and recurring (DECISIONS.md D1)
# ===========================================================================
SHOPIFY_STORE_DOMAIN=itscold.myshopify.com

# Webhook signing secret. Without it, /api/webhooks/shopify refuses every request: accepting
# unverified payment webhooks would let anyone mint a paid job.
SHOPIFY_WEBHOOK_SECRET=

# Custom app admin token with read_orders, used by the hourly sweep to find dropped webhooks.
SHOPIFY_ADMIN_API_TOKEN=

# Storefront API token. Optional but recommended: the only way to put a different selling plan on
# each line of a checkout. Without it, a two-subscription checkout fails loudly rather than
# silently dropping the customer's email add-on.
SHOPIFY_STOREFRONT_TOKEN=

# --- Product variant ids -------------------------------------------------------
# The handle in each variable name is the REAL handle on the store, read on 2026-08-18.
# Full instructions, including which products still have to be created: SHOPIFY-SETUP.md
SHOPIFY_VARIANT_WEBSITE_HOSTING_AUSTRALIA=
SHOPIFY_VARIANT_DOMAIN_1_YEAR=
SHOPIFY_VARIANT_EMAIL_HOSTING=

# These four products DO NOT EXIST on the store yet. Nothing in the app guesses a handle for them:
# a checkout for one throws by name saying what to create. See SHOPIFY-SETUP.md step 5.
SHOPIFY_VARIANT_BUILD_TOKEN=
SHOPIFY_VARIANT_POST_LIVE_EDIT=
SHOPIFY_VARIANT_DISCHARGE=
# Only once the extra-edits price is decided (DECISIONS.md D2).
SHOPIFY_VARIANT_EXTRA_EDITS=

# --- Selling plan ids, subscriptions only --------------------------------------
# The store has ZERO selling plan groups today, so nothing rebills. SHOPIFY-SETUP.md steps 3 and 4.
SHOPIFY_SELLING_PLAN_WEBSITE_HOSTING_AUSTRALIA=
SHOPIFY_SELLING_PLAN_DOMAIN_1_YEAR=
SHOPIFY_SELLING_PLAN_EMAIL_HOSTING=

# ===========================================================================
# RESEND - transactional email
# ===========================================================================
RESEND_API_KEY=
RESEND_FROM="Go Polar Creative <build@itscold.com.au>"

# ===========================================================================
# GOHIGHLEVEL - CRM
# ===========================================================================
GHL_INBOUND_WEBHOOK_URL=

# ===========================================================================
# VERCEL - attaching customer domains at go live
# ===========================================================================
# Token with access to the project. Only used when ENABLE_LIVE_DOMAINS is on.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ===========================================================================
# CRON AND ADMIN
# ===========================================================================
# Vercel sets this automatically when a cron job is added. The sweep endpoint refuses to run in
# production without it.
CRON_SECRET=

# Required in production for the human steps, currently releasing a discharge package.
# Sent as the x-admin-token header.
ADMIN_TOKEN=

# Optional: a different DNS-over-HTTPS resolver for the domain lookups.
DOH_ENDPOINT=
