# Go Polar Website Builder - environment reference
#
# TWO PLACES SECRETS LIVE:
#   Local dev  -> copy this file to `.dev.vars` (gitignored). Wrangler loads it into the Worker.
#   Production -> `npx wrangler secret put NAME`. Never in wrangler.jsonc, never in the client bundle.
#
# NOTHING IN THIS FILE IS EVER READ BY THE BROWSER. Vite only exposes vars prefixed VITE_,
# and there are deliberately none here. If a key ever appears in dist/client, that is a build failure.

# ---------------------------------------------------------------------------
# Anthropic (Phase 2 - generation)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for both the content-plan call and the build call.
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Go Polar infrastructure injected server side (never asked of the customer)
# ---------------------------------------------------------------------------
# Web3Forms access key stamped into every generated site. Must be a UUID.
# On discharge this is swapped for the customer's own key (see section 9 of the brief).
WEB3FORMS_ACCESS_KEY=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Shopify (Phase 6 - not wired yet, keys listed so the shape is known)
# ---------------------------------------------------------------------------
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_STORE_DOMAIN=itscold.myshopify.com

# ---------------------------------------------------------------------------
# Resend (Phase 6 - transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Go Polar Creative <build@itscold.com.au>"

# ---------------------------------------------------------------------------
# GoHighLevel (Phase 6 - CRM webhooks)
# ---------------------------------------------------------------------------
GHL_INBOUND_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to sign build tokens and session cookies (Phase 6). Generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_SECRET=
PUBLIC_APP_URL=https://build.itscold.com.au
