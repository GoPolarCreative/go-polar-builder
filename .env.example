# Go Polar Website Builder - environment reference
#
# TWO PLACES SECRETS LIVE:
#   Local dev  -> copy this file to `.dev.vars` (gitignored). Wrangler loads it into the Worker.
#   Production -> `npx wrangler secret put NAME`. Never in wrangler.jsonc, never in the client bundle.
#
# NOTHING IN THIS FILE IS EVER READ BY THE BROWSER. Vite only exposes vars prefixed VITE_,
# and there are deliberately none here. `npm run build` fails if a secret reaches dist/client.
#
# Everything below is read from env at runtime. Nothing is hardcoded anywhere in the source, and
# nothing is stubbed: with a variable missing, the feature that needs it fails with an error
# naming that exact variable rather than pretending to work.

# ===========================================================================
# REQUIRED FOR THE APP TO FUNCTION AT ALL
# ===========================================================================

# Signs build tokens, session cookies and discharge download links.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_SECRET=

# Where the app is served from. Used to build emailed links, so it must be the real public URL.
PUBLIC_APP_URL=https://build.itscold.com.au

# ---------------------------------------------------------------------------
# Anthropic - generation (Phase 2)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Runs generation against a deterministic offline fixture instead of the Anthropic API, so the
# pipeline and all 16 verification checks can be exercised without a key.
# NEVER SET THIS IN PRODUCTION.
# DEV_OFFLINE_GENERATION=1

# ---------------------------------------------------------------------------
# Go Polar infrastructure injected server side (never asked of the customer)
# ---------------------------------------------------------------------------
# Web3Forms access key stamped into every generated site. Must be a UUID.
# Swapped for the customer's own key on discharge (brief s9).
WEB3FORMS_ACCESS_KEY=00000000-0000-0000-0000-000000000000

# ===========================================================================
# SHOPIFY - all payments, one-off and recurring (brief s3a, DECISIONS.md D1)
# ===========================================================================

SHOPIFY_STORE_DOMAIN=itscold.myshopify.com

# Webhook signing secret from the Shopify webhook settings. Without it, /api/webhooks/shopify
# refuses every request: accepting unverified payment webhooks would let anyone mint a paid job.
SHOPIFY_WEBHOOK_SECRET=

# Custom app admin token with read_orders. Used by the hourly sweep to find paid orders whose
# webhook was dropped. Without it the sweep reports that it cannot reconcile, and says why.
SHOPIFY_ADMIN_API_TOKEN=

# Storefront API token. Optional but recommended: it is the only way to put a different selling
# plan on each line of a checkout. Without it, checkouts fall back to a cart permalink, which can
# carry only one subscription line, and a two-subscription checkout fails loudly rather than
# silently dropping the customer's email add-on.
SHOPIFY_STOREFRONT_TOKEN=

# --- Product variant ids -----------------------------------------------------
# One per product, from Shopify once the products exist. The name is derived from the product
# handle: build-token -> SHOPIFY_VARIANT_BUILD_TOKEN.
SHOPIFY_VARIANT_BUILD_TOKEN=
SHOPIFY_VARIANT_HOSTING_MONTHLY=
SHOPIFY_VARIANT_DOMAIN_MONTHLY=
SHOPIFY_VARIANT_EMAIL_MONTHLY=
SHOPIFY_VARIANT_POST_LIVE_EDIT=
SHOPIFY_VARIANT_DISCHARGE=
# Only needed once the extra-edits price is decided. See DECISIONS.md D2.
SHOPIFY_VARIANT_EXTRA_EDITS=

# --- Selling plan ids, subscriptions only ------------------------------------
# From whichever subscription app is installed. Chris to confirm which one before these are set.
SHOPIFY_SELLING_PLAN_HOSTING_MONTHLY=
SHOPIFY_SELLING_PLAN_DOMAIN_MONTHLY=
SHOPIFY_SELLING_PLAN_EMAIL_MONTHLY=

# ===========================================================================
# RESEND - transactional email
# ===========================================================================
# Go Polar controls these emails, not Shopify's order confirmation, so the branding and the
# instructions are right. A send failure is recorded as email.failed and retried by the hourly
# sweep: a paying customer who never receives a link is the worst failure in this system.
RESEND_API_KEY=
RESEND_FROM="Go Polar Creative <build@itscold.com.au>"

# ===========================================================================
# GOHIGHLEVEL - CRM
# ===========================================================================
# Inbound webhook URL. Fired on payment received, intake abandoned, build complete, editing
# stalled, go live requested, site live and discharge requested (brief s12).
GHL_INBOUND_WEBHOOK_URL=

# ===========================================================================
# ADMIN
# ===========================================================================
# Required in production for the human steps, currently releasing a discharge package.
# Sent as the x-admin-token header. Without it set, those routes refuse to run on any install
# that has a Shopify secret configured.
# Generate with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=
