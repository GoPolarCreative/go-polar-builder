{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for two reasons, neither of which is server code touching a document:
    //   - the page.evaluate probe in lib/checks/render.ts runs inside the headless browser
    //   - WebCrypto and fetch types come from the DOM lib in this setup
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["server", "shared", "db", "api", "test", "scripts/**/*.ts"]
}
