{
  "name": "go-polar-website-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Go Polar Website Builder - self-serve single-page site generator for Australian trade businesses",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check:bundle": "node scripts/check-bundle.mjs",
    "seed": "node scripts/seed.mjs",
    "db:migrate:local": "wrangler d1 execute go-polar-builder --local --file=./db/schema.sql --yes",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "db:migrate:remote": "wrangler d1 execute go-polar-builder --remote --file=./db/schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
