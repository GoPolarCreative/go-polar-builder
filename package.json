{
  "name": "go-polar-website-builder",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Go Polar Website Builder - self-serve single-page site generator for Australian trade businesses",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/local.ts",
    "dev:web": "vite",
    "build": "node scripts/add-import-extensions.mjs --check && tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "check:bundle": "node scripts/check-bundle.mjs",
    "seed": "tsx scripts/seed.ts",
    "e2e": "node scripts/e2e.mjs",
    "sample": "tsx scripts/build-sample-site.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:studio": "drizzle-kit studio",
    "vercel:build": "node scripts/add-import-extensions.mjs --check && tsc -b && vite build && node scripts/check-bundle.mjs",
    "predeploy": "node -e \"console.error('Deploying is a deliberate act. Run: npx vercel --prod. See README.');process.exit(1)\"",
    "sample:verify": "tsx scripts/check-sample.ts",
    "e2e:pageset": "tsx scripts/e2e-pageset.mjs",
    "vercel:env": "node scripts/make-vercel-env.mjs",
    "check:imports": "node scripts/add-import-extensions.mjs --check",
    "vercel:push": "node scripts/push-env.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@hono/node-server": "^2.1.1",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "node-html-parser": "^9.0.1",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
