{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "(build\\.itscold\\.com\\.au|.*\\.vercel\\.app|localhost(:\\d+)?)"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/api/index"
    }
  ]
}
